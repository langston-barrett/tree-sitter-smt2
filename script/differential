#!/usr/bin/env bash
# Differential test: check that tree-sitter-smt2 accepts exactly the corpus
# files that Z3's parser accepts.
#
# Usage: script/differential [CORPUS_DIR]
#
# Environment:
#   ORACLE       command that classifies files (see oracle/); defaults to
#                oracle/z3-parse-oracle.py, which needs uv
#
# The oracle labels each file `ok`, `syntax` (a lexical or grammatical
# error), or `semantic` (rejected for another reason, e.g., an undeclared
# symbol).  tree-sitter must reject exactly the `syntax` files, except for
# those listed in script/differential-exceptions.  Files that the oracle
# cannot classify (`crash`, `error`, `timeout`), e.g., because Z3 crashes on
# them, are skipped.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
corpus=$(cd "${1:-$root/corpus}" && pwd)
exceptions=$root/script/differential-exceptions
oracle=${ORACLE:-$root/oracle/z3-parse-oracle.py}

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

"$root/script/list-corpus" "$corpus" > "$work/files"
echo "Corpus: $(wc -l < "$work/files" | tr -d ' ') files" >&2

# Oracle verdicts: "<label> <file>"
(cd "$corpus" && xargs "$oracle" < "$work/files") |
  cut -f1 | awk '{ print $1, $2 }' | LC_ALL=C sort -k2 > "$work/oracle"
if grep -v -E '^(ok|syntax|semantic|crash|error|timeout) ' "$work/oracle" >&2; then
  echo "error: the oracle failed on the files above" >&2
  exit 1
fi
if [[ $(wc -l < "$work/oracle") -ne $(wc -l < "$work/files") ]]; then
  echo "error: the oracle did not classify every file" >&2
  exit 1
fi

# Files tree-sitter rejects.
node "$root/script/rejected.mjs" "$work/files" "$corpus" | LC_ALL=C sort -u > "$work/ts-rejected"

# Expected mismatches.
grep -v -E '^(#|$)' "$exceptions" 2> /dev/null | cut -f1 | LC_ALL=C sort -u > "$work/exceptions" || true

awk -v rejected="$work/ts-rejected" '
  BEGIN { while ((getline f < rejected) > 0) bad[f] = 1 }
  {
    label = $1; file = $2
    if (label == "crash" || label == "error" || label == "timeout") next
    if (label == "syntax" && !(file in bad)) print file "\tZ3 rejects, tree-sitter accepts"
    if (label != "syntax" && (file in bad)) print file "\tZ3 accepts, tree-sitter rejects"
  }
' "$work/oracle" | LC_ALL=C sort > "$work/mismatches"

awk '{ print $1 }' "$work/oracle" | sort | uniq -c | sed 's/^/  oracle: /' >&2
echo "  tree-sitter rejects: $(wc -l < "$work/ts-rejected" | tr -d ' ')" >&2

status=0
unexpected=$(cut -f1 "$work/mismatches" | LC_ALL=C comm -23 - "$work/exceptions")
if [[ -n $unexpected ]]; then
  echo "Unexpected mismatches:" >&2
  grep -F -f <(echo "$unexpected") "$work/mismatches" | sed 's/^/  /' >&2
  status=1
fi
stale=$(cut -f1 "$work/mismatches" | LC_ALL=C comm -13 - "$work/exceptions")
if [[ -n $stale ]]; then
  echo "Listed in $(basename "$exceptions") but no longer mismatched:" >&2
  while IFS= read -r file; do echo "  $file"; done <<< "$stale" >&2
  status=1
fi
if [[ $status -eq 0 ]]; then
  echo "OK: tree-sitter agrees with Z3 on every file" >&2
fi
exit $status
